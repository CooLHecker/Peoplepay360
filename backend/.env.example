# Local dev: a SQLite file created automatically in backend/ — no DB
# server to install or run. Just leave this as-is.
DATABASE_URL=sqlite:///./interloop.db
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# --- Optional: only needed if you switch DATABASE_URL to MySQL ---
# e.g. DATABASE_URL=mysql+pymysql://user:password@localhost:3306/interloop
# Managed MySQL (e.g. Aiven) requires TLS. PyMySQL ignores the
# ?ssl-mode=REQUIRED query param some providers give you in their
# connection string, so set these instead:
DB_SSL_REQUIRED=false
# Optional: path to the provider's CA cert for full certificate
# verification (e.g. ./certs/aiven-ca.pem). Leave unset to still get
# an encrypted connection without hostname/CA verification.
DB_SSL_CA=

# Only used by `python -m app.db.seed` to create the very first Admin
# account — a bootstrap step, since the User Management screen itself
# requires being logged in as an Admin/HR Manager to grant any roles.
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Also only used by the seed script: creates one plain "employee"-role
# account (linked to its own Employee record) so you have something
# to sign in as at /employee-login to see the non-admin experience.
# Once logged in as the bootstrap Admin, use User Management in the
# sidebar to promote this (or any) employee to HR Manager, HR Payroll
# User/Admin, or Admin.
DEMO_EMPLOYEE_EMAIL=employee@yourcompany.com
DEMO_EMPLOYEE_PASSWORD=change-me-too
DEMO_EMPLOYEE_NAME=Demo Employee

# --- Attendance geofencing ---
# REQUIRED for real use: these placeholder coordinates (0, 0) are in
# the ocean off the coast of Africa. Every check-in will be rejected
# as "outside the office" until you replace these with your actual
# office's latitude/longitude (e.g. from Google Maps: right-click the
# office location -> the decimal coordinates shown at the top).
OFFICE_LATITUDE=0.0
OFFICE_LONGITUDE=0.0
# Acceptable distance from the office, in meters, for a check-in/out
# to be considered valid.
OFFICE_GEOFENCE_RADIUS_M=100.0

# A check-in after this time of day (IST) shows as "Late" instead of
# "Present" on the admin Attendance dashboard.
ATTENDANCE_LATE_AFTER_HOUR=9
ATTENDANCE_LATE_AFTER_MINUTE=15

# --- Employee assistant chatbot ---
# Powers the "Interloop assistant" chat widget on the employee
# dashboard (backend/app/api/v1/endpoints/chat.py) via Google's Gemini
# API. Get a free key at https://aistudio.google.com/apikey — kept
# server-side only, it is never sent to the browser. Leave blank to
# disable the chatbot (it will show a friendly "not configured" error).
GEMINI_API_KEY=
# Google's own floating alias for its current fast/cheap Flash model.
# Override with a specific model name (e.g. gemini-2.5-flash) if you
# want to pin a version instead of following Google's updates.
GEMINI_MODEL=gemini-flash-latest
